# Crewora Frontend Environment Variables
# Copy to .env.local and fill values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mobile App Configuration
NEXT_PUBLIC_ANDROID_APK_URL=http://localhost:5000/uploads/crewora-app.apk
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_RELEASE_DATE=June 2, 2026
NEXT_PUBLIC_APK_SIZE=15.4 MB
NEXT_PUBLIC_MIN_ANDROID_VERSION=Android 8.0 (Oreo) or higher


datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("moderator") // "super_admin", "moderator", "support"
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Customer {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  passwordHash         String
  phone                String
  address              String?
  latitude             Float?
  longitude            Float?
  isVerified           Boolean   @default(false)
  isActive             Boolean   @default(true)
  loginAttempts        Int       @default(0)
  lockUntil            DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  refreshTokenHash     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  jobs                 Job[]
}

model Worker {
  id                          String    @id @default(uuid())
  name                        String
  email                       String    @unique
  passwordHash                String
  phone                       String
  tradeCategories             String[]
  bio                         String?
  experienceYears             Int?
  city                        String
  serviceRadius               Int       @default(20)
  latitude                    Float?
  longitude                   Float?
  profilePhoto                String?
  certifications              String[]
  availability                String    @default("available") // "available", "unavailable", "on_a_job"
  verificationStatus          String    @default("pending") // "pending", "approved", "rejected"
  verificationRejectionReason String?
  isActive                    Boolean   @default(true)
  loginAttempts               Int       @default(0)
  lockUntil                   DateTime?
  refreshTokenHash            String?
  passwordResetToken          String?
  passwordResetExpires        DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  matches                     Match[]
  assignedJobs                Job[]     @relation("WorkerJobs")
}

model Job {
  id                 String    @id @default(uuid())
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title              String
  description        String
  tradeCategory      String
  address            String
  latitude           Float
  longitude          Float
  urgency            String // "asap", "scheduled"
  scheduledAt        DateTime?
  status             String    @default("open") // "draft", "open", "matched", "in_progress", "completed", "cancelled"
  assignedWorkerId   String?
  assignedWorker     Worker?   @relation("WorkerJobs", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  postedAt           DateTime  @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  matches            Match[]
}

model Match {
  id          String    @id @default(uuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId    String
  worker      Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // "pending", "accepted", "declined", "expired"
  matchedAt   DateTime  @default(now())
  respondedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([jobId, workerId])
}

model Message {
  id           String   @id @default(uuid())
  jobId        String?  
  senderId     String
  senderRole   String   // "customer" | "worker" | "system"
  receiverId   String
  receiverRole String   // "customer" | "worker"
  content      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

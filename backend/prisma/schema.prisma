datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  passwordHash     String
  role             String    @default("moderator") // "super_admin", "moderator", "support"
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Customer {
  id                   String    @id @default(uuid())
  name                 String
  phone                String    @unique
  address              String?
  latitude             Float?
  longitude            Float?
  isVerified           Boolean   @default(false)
  isActive             Boolean   @default(true)
  languagePreference   String?   @map("language_preference")
  refreshTokenHash     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  jobs                 Job[]
  reviews              Review[]
}

model Worker {
  id                          String    @id @default(uuid())
  name                        String
  phone                       String    @unique
  tradeCategories             String[]
  bio                         String?
  experienceYears             Int?
  city                        String
  serviceRadius               Int       @default(20)
  latitude                    Float?
  longitude                   Float?
  profilePhoto                String?
  certifications              String[]
  availability                String    @default("available") // "available", "unavailable", "on_a_job"
  verificationStatus          String    @default("pending") // "pending", "approved", "rejected"
  verificationRejectionReason String?
  isActive                    Boolean   @default(true)
  languagePreference          String?   @map("language_preference")
  refreshTokenHash            String?
  ratingAvg                   Float     @default(0)
  totalReviews                Int       @default(0)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  deletedAt                   DateTime?
  matches                     Match[]
  assignedJobs                Job[]     @relation("WorkerJobs")
  reviews                     Review[]
  hourlyRate                  Int?            @default(0)
  portfolioItems              PortfolioItem[]
}

model PortfolioItem {
  id        String   @id @default(uuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  title     String
  image     String
  createdAt DateTime @default(now())
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  code      String
  userType  String   // "customer" | "worker"
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([phone, isUsed, expiresAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([isRead, userId])
}

model Job {
  id                 String    @id @default(uuid())
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title              String
  description        String
  tradeCategory      String
  address            String
  latitude           Float
  longitude          Float
  urgency            String // "asap", "scheduled"
  scheduledAt        DateTime?
  status             String    @default("open") // "draft", "open", "matched", "in_progress", "completed", "cancelled"
  assignedWorkerId   String?
  assignedWorker     Worker?   @relation("WorkerJobs", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  postedAt           DateTime  @default(now())
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  city               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  matches            Match[]
  reviews            Review[]

  @@index([customerId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([status])
}

model Match {
  id          String    @id @default(uuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId    String
  worker      Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // "pending", "accepted", "declined", "expired"
  matchedAt   DateTime  @default(now())
  respondedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([jobId, workerId])
  @@index([workerId, status])
}

model Message {
  id           String   @id @default(uuid())
  jobId        String?  
  senderId     String
  senderRole   String   // "customer" | "worker" | "system"
  receiverId   String
  receiverRole String   // "customer" | "worker"
  content      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  userType  String   // "customer" | "worker"
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id         String   @id @default(uuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workerId   String
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  reviewer   String   @default("customer") // "customer" | "worker"
  rating     Int      // 1 to 5 stars
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([jobId, reviewer])
  @@index([workerId])
  @@index([customerId, jobId])
}

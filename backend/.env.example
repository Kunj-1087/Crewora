# =============================================
# CREWORA BACKEND — ENVIRONMENT VARIABLES
# =============================================
# Copy this file to .env and fill in all values
# NEVER commit .env to version control

# App
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/crewora

# JWT — Customer Tokens (separate from worker!)
JWT_CUSTOMER_ACCESS_SECRET=your_customer_access_secret_min_32_chars
JWT_CUSTOMER_REFRESH_SECRET=your_customer_refresh_secret_min_32_chars

# JWT — Worker Tokens (separate from customer!)
JWT_WORKER_ACCESS_SECRET=your_worker_access_secret_min_32_chars
JWT_WORKER_REFRESH_SECRET=your_worker_refresh_secret_min_32_chars

# JWT — Admin Tokens
JWT_ADMIN_ACCESS_SECRET=your_admin_access_secret_min_32_chars

# JWT Expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Crewora <noreply@crewora.com>"

# Security (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=64_hex_chars_32_bytes_encryption_key_here


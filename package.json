{
  "name": "crewora-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:web": "npm --prefix apps/web run build",
    "build:mobile": "npm --prefix apps/mobile run build",
    "build:backend": "npm --prefix backend run build",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:start": "npm --prefix backend run db:start",
    "db:stop": "npm --prefix backend run db:stop"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1"
  }
}
